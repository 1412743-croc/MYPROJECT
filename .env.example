# MindBridge development settings. Do not put secrets in this file.
APP_ENV=development
DATABASE_URL=sqlite:///./data/mindbridge.db

# AI provider: mock, openai, or ollama
AI_PROVIDER=mock
AI_TIMEOUT_SECONDS=30
AI_TEMPERATURE=0.4
AI_HISTORY_LIMIT=10

# OpenAI-compatible Chat Completions
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# Local Ollama native chat API
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
